@article{shiromani2026hypocrisy,
  abbr        = {Preprint},
  bibtex_show = {true},
  selected    = {true},
  title       = {The Hypocrisy Gap: Quantifying Divergence Between Internal Belief and Chain-of-Thought Explanation via Sparse Autoencoders},
  author      = {Shiromani, Shikhar and Chaudhury, Archie and Kunda, Sri Pranav},
  year        = {2026},
  month       = {January},
  eprint      = {2602.02496},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  arxiv       = {2602.02496},
  url         = {https://arxiv.org/abs/2602.02496},
  abstract    = {We introduce the Hypocrisy Gap, a mechanistic metric using Sparse Autoencoders to quantify the divergence between a model's internal reasoning and its final generation. By comparing an internal truth belief, derived via sparse linear probes, to the final generated trajectory in latent space, we detect a model's tendency toward unfaithful behavior. On Gemma, Llama, and Qwen, the method reaches AUROC 0.55-0.74, consistently outperforming a decision-aligned log-probability baseline.}
}

